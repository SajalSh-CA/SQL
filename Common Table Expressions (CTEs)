Common Table Expressions (CTEs)

WITH low_stock_books AS (
         SELECT *
         FROM books
         WHERE stock_count <5
         )
SELECT title, stock_count
FROM low_stock_books;


WITH user_stream_counts AS (
    SELECT user_id, COUNT(stream_id) AS Total_strems
    FROM video_streams                        
    GROUP BY user_id                          
)
SELECT user_id, Total_strems                
FROM user_stream_counts
WHERE Total_strems > 5;


----Complex (multi)
WITH store_analytics AS(
SELECT store_location,
               COUNT(sale_id) as total_sales,
               SUM(item_price) AS total_revenue,
               AVG(item_price) AS avg_sales
               FROM sales_data
               GROUP BY store_location
               )
SELECT total_sales, total_revenue, avg_sales
FROM store_analytics
WHERE total_revenue >10000;
