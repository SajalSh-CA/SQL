SELECT order_id, customer_id
FROM orders
WHERE shipping_country IN ('UK', 'France', 'Germany')

  AND order_date BETWEEN '2025-11-01' AND '2025-12-31' AND total_amount > 500
       OR
       promo_code LIKE 'WINTER%'

----

SELECT order_id, customer_id
FROM orders
WHERE total_amount >999 AND status <> ('Delivered' OR 'Cancelled')
                      AND shipping_country <> ('USA' OR 'Canada');

----

SELECT order_id, customer_id
FROM orders
WHERE total_amount >= 1000
  AND status NOT IN ('Delivered', 'Cancelled')
  AND shipping_country NOT IN ('USA', 'Canada');

----

SELECT order_id, customer_id
FROM orders
WHERE total_amount >= 1000
  AND (status <> 'Delivered' AND status <> 'Cancelled')
  AND (shipping_country <> 'USA' AND shipping_country <> 'Canada');


