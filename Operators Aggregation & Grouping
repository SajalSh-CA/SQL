SELECT FirstName, LastName, Salary
FROM employees
WHERE department = 'Sales'
ORDER BY salary ASC
LIMIT 3;

----

SELECT item_name, cuisine, status, price
FROM online_orders  -- Added the 's'
WHERE cuisine = 'Asian'
  AND status = 'Completed'
ORDER BY price ASC
LIMIT 2;


----

SELECT room_number, room_type, status
FROM hotel_rooms
WHERE status = 'Available'
            AND (
                 (room_type = 'Deluxe Suite')
              OR (has_belcony = 'yes')
                     )
ORDER BY price_per_night DESC
LIMIT 2;


