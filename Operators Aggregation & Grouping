SELECT username
FROM users
WHERE is_admin = FALSE
      AND failed_login_attempts >= 1
        AND ( email LIKE '%ru' OR email LIKE  '%xyz'
          OR last_login_date BETWEEN '2026-09-01' AND '2026-09-25'
              AND failed_login_attempts >5
                 );
