SELECT transaction_id
FROM transactions
WHERE status IN ('Approved', 'Pending')
     AND amount >=500
        AND (

              (account_type <> 'Savings' AND location IN ('Nigeria', 'Unknown', 'etc'))
        OR    (merchant_name LIKE 'Crypto%' OR merchant_name LIKE '%Bet')
        OR    (amount BETWEEN 5000 AND 10000 AND location NOT IN ('USA', 'Canada', 'UK'))

            );

