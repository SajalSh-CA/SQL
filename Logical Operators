SELECT account_id, company_name
FROM billing_ledger
WHERE
    -- Condition 1: Domestic with a high balance
    region = 'Domestic' AND total_balance > 1000.00
    OR
    -- Condition 2: Unpaid with no override code
    invoice_status = 'Unpaid' AND override_code IS NULL;

